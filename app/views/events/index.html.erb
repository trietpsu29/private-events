<% if user_signed_in? %>
  <h1>Welcome back, <%= current_user.name %>!</h1>
<% else %>
  <h1>Welcome to EventHub</h1>
  <p>Create events, invite your friends, and join gatherings together.</p>
<% end %>
<h2>Upcoming Events</h2>
<ul>
  <%= render partial: "event_summary", collection: Event.future, as: :event %>
</ul>
<h2>Past Events</h2>
<ul>
  <%= render partial: "event_summary", collection: Event.past, as: :event %>
</ul>