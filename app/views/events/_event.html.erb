<li>
  <h3><%= event.title %></h3>
  <p><%= event.description %></p>
  <p>Author: <%= event.creator.name %></p>
  <p>Date: <%= event.date %></p>
  <p>Location: <%= event.location %></p>
  <p>Attendees:</p>
  <ul>
    <% event.attendees.each do |attendee| %>
      <li><%= attendee.name %></li>
    <% end %>
  </ul>
  <% if user_signed_in? %>
    <% attendance = event.attendances.find_by(attendee: current_user)%>
    <% if attendance.nil? %>
      <%= button_to "Attend", event_attendances_path(event) %>
    <% else %>
      <%= button_to "Leave event", event_attendance_path(event,attendance), method: :delete %>
    <% end %>
    <% if current_user==event.creator%>
      <%= link_to "Invite", new_event_invitation_path(event) %>
      <%= link_to "Edit", edit_event_path(event) %>
      <%= button_to "Delete", event_path(event), method: :delete %>
    <% end %>
  <% end %>
</li>